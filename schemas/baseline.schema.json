{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delivery Baseline",
  "description": "Persistent per-project memory produced by sow-intake. Every source-derived value carries a source citation or the literal string NOT_FOUND.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "client",
    "project_name",
    "engagement_type",
    "language",
    "dates",
    "milestones",
    "scope_items",
    "deliverables",
    "assumptions",
    "exclusions",
    "slas",
    "commercials",
    "risk_flags",
    "extraction_meta",
    "human_review"
  ],
  "definitions": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "quote", "source_line_start", "source_line_end"],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1,
          "description": "Section or clause identifier, for example 3.2, E1, or M4."
        },
        "quote": {
          "type": "string",
          "minLength": 20,
          "description": "Exact source text. validate_citations.py rejects normalized or approximate matches."
        },
        "source_line_start": { "type": "integer", "minimum": 1 },
        "source_line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "cited_string": {
      "oneOf": [
        { "const": "NOT_FOUND" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "citation"],
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "citation": { "$ref": "#/definitions/citation" }
          }
        }
      ]
    },
    "cited_number": {
      "oneOf": [
        { "const": "NOT_FOUND" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "citation"],
          "properties": {
            "value": { "type": "number" },
            "citation": { "$ref": "#/definitions/citation" }
          }
        }
      ]
    },
    "cited_date": {
      "oneOf": [
        { "const": "NOT_FOUND" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "citation"],
          "properties": {
            "value": { "type": "string", "format": "date" },
            "citation": { "$ref": "#/definitions/citation" }
          }
        }
      ]
    },
    "cited_engagement": {
      "oneOf": [
        { "const": "NOT_FOUND" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "citation"],
          "properties": {
            "value": {
              "enum": ["fixed_price", "time_and_materials", "staff_augmentation"]
            },
            "citation": { "$ref": "#/definitions/citation" }
          }
        }
      ]
    },
    "cited_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "citation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citation": { "$ref": "#/definitions/citation" }
      }
    }
  },
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Equal to the project folder name. This identifier comes from the filesystem, not the SOW."
    },
    "client": { "$ref": "#/definitions/cited_string" },
    "project_name": { "$ref": "#/definitions/cited_string" },
    "engagement_type": { "$ref": "#/definitions/cited_engagement" },
    "language": { "$ref": "#/definitions/cited_string" },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": { "$ref": "#/definitions/cited_date" },
        "end_date": { "$ref": "#/definitions/cited_date" }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "date", "citation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "enum": ["TBD", "NOT_FOUND"] }
            ]
          },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "scope_items": { "type": "array", "items": { "$ref": "#/definitions/cited_item" } },
    "deliverables": { "type": "array", "items": { "$ref": "#/definitions/cited_item" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/definitions/cited_item" } },
    "exclusions": { "type": "array", "items": { "$ref": "#/definitions/cited_item" } },
    "slas": { "type": "array", "items": { "$ref": "#/definitions/cited_item" } },
    "commercials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "currency"],
      "properties": {
        "model": { "$ref": "#/definitions/cited_engagement" },
        "currency": { "$ref": "#/definitions/cited_string" },
        "total_value": { "$ref": "#/definitions/cited_number" },
        "payment_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "percent", "amount", "citation"],
            "properties": {
              "trigger": { "type": "string", "minLength": 1 },
              "percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "amount": { "type": "number", "minimum": 0 },
              "citation": { "$ref": "#/definitions/citation" }
            }
          }
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "hourly_rate", "citation"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "hourly_rate": { "type": "number", "minimum": 0 },
              "citation": { "$ref": "#/definitions/citation" }
            }
          }
        },
        "monthly_hours_cap": {
          "oneOf": [
            { "const": "NOT_FOUND" },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "citation"],
                "properties": {
                  "value": { "type": "number", "minimum": 0 },
                  "citation": { "$ref": "#/definitions/citation" }
                }
              }
            }
          ]
        },
        "estimated_duration_weeks": {
          "oneOf": [
            { "const": "NOT_FOUND" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "citation"],
              "properties": {
                "value": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0 },
                  "minItems": 2,
                  "maxItems": 2
                },
                "citation": { "$ref": "#/definitions/citation" }
              }
            }
          ]
        },
        "team": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "fte", "monthly_hours_per_fte", "monthly_fee_per_fte", "citation"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "fte": { "type": "number", "minimum": 0 },
              "monthly_hours_per_fte": { "type": "number", "minimum": 0 },
              "monthly_fee_per_fte": { "type": "number", "minimum": 0 },
              "citation": { "$ref": "#/definitions/citation" }
            }
          }
        },
        "stated_monthly_fee": { "$ref": "#/definitions/cited_number" },
        "term_months": { "$ref": "#/definitions/cited_number" },
        "stated_term_total": { "$ref": "#/definitions/cited_number" }
      },
      "allOf": [
        {
          "if": { "properties": { "model": { "type": "object", "required": ["value"], "properties": { "value": { "const": "fixed_price" } } } } },
          "then": { "required": ["total_value", "payment_schedule"] }
        },
        {
          "if": { "properties": { "model": { "type": "object", "required": ["value"], "properties": { "value": { "const": "time_and_materials" } } } } },
          "then": { "required": ["rates", "monthly_hours_cap", "estimated_duration_weeks"] }
        },
        {
          "if": { "properties": { "model": { "type": "object", "required": ["value"], "properties": { "value": { "const": "staff_augmentation" } } } } },
          "then": { "required": ["team", "stated_monthly_fee", "term_months", "stated_term_total"] }
        }
      ]
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "description"],
        "properties": {
          "type": {
            "enum": [
              "missing_end_date",
              "missing_start_date",
              "milestone_tbd",
              "missing_assumptions_section",
              "missing_exclusions_section",
              "undefined_sla_reference",
              "hours_cap_contradiction",
              "numeric_contradiction",
              "engagement_model_mismatch",
              "client_controlled_prioritization",
              "undefined_urgent_support_sla",
              "unusual_penalty",
              "ambiguous_scope_language",
              "prompt_injection_detected",
              "other"
            ]
          },
          "severity": { "enum": ["low", "medium", "high"] },
          "description": { "type": "string", "minLength": 1 },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "extraction_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extracted_at", "source_file", "fields_not_found", "fields_pending_review"],
      "properties": {
        "model": { "type": "string" },
        "extracted_at": { "type": "string", "format": "date-time" },
        "source_file": { "type": "string", "minLength": 1 },
        "fields_not_found": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "fields_pending_review": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Intake writes pending. A human must approve before scope-sentinel may classify.",
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
